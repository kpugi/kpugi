{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/verify-submissions",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/daily-settlement",
